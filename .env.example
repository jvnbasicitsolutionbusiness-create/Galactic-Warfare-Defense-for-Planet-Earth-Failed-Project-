# ═══════════════════════════════════════════════════════════════════
#  Galactic Warfare: Defense for Planet Earth — Environment Configuration
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Comma-separated origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session signing secret
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=replace_with_a_long_random_secret_string


# ─── Google Sheets — Primary Database ────────────────────────────
#
# ALL game data (auth, progression, galactic coins, high scores) is
# stored in Google Sheets via a deployed Apps Script web-app.
# No Firebase, no service accounts, no private keys needed.
#
# HOW TO SET UP:
#  1. Create a Google Sheet (or use an existing one).
#     Give it tabs: Accounts | Progression | HighScores
#
#  2. Open Extensions → Apps Script in that sheet.
#     Paste the full contents of  docs/apps-script-webhook.js.
#     Save with Ctrl+S.
#
#  3. Deploy → New deployment
#       Type:        Web App
#       Execute as:  Me
#       Who can access: Anyone
#     Click Deploy → Authorize when prompted.
#
#  4. Copy the deployment URL ("Web app URL") here:
GOOGLE_APPS_SCRIPT_URL=your_google_sheets_spreadsheet_url_here

#  5. Copy the Spreadsheet ID from the sheet URL:
#       https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_ID=your_google_sheets_spreadsheet_id_here


# ─── Audio Assets Note ────────────────────────────────────────────
#
# Audio files are loaded as static assets from /public/assets/audio/.
# Place your OGG/MP3 files in the correct subdirectory:
#   music/  — background music tracks (battle, menu, victory, defeat, loading)
#   sfx/    — gameplay sound effects
#   ui/     — button clicks, menu sounds
#
# See docs/apps-script-webhook.js for the Sheets API contract.
